# Copy this file to .env and fill in real values. Never commit .env.
#
# Local development: run a disposable Postgres in Docker, then point
# DATABASE_URL at it:
#
#   docker run -d --name glowup-postgres \
#     -e POSTGRES_USER=glowup -e POSTGRES_PASSWORD=glowup -e POSTGRES_DB=glowup \
#     -p 5432:5432 postgres:17-alpine
#
# Practice project: deployed database is Neon Free (see docs/TECH_STACK.md).
DATABASE_URL="postgresql://glowup:glowup@localhost:5432/glowup?schema=public"

# Signs/verifies staff session cookies (M4, docs/DECISIONS.md 27 Oct 2026).
# Any long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-string"

# Paystack, test mode only (M8, docs/TECH_STACK.md). Get these from
# https://dashboard.paystack.com under Settings > API Keys & Webhooks, with
# "Test Mode" switched on (top-right toggle) — never use live keys here.
PAYSTACK_PUBLIC_KEY="pk_test_replace-with-your-test-public-key"
PAYSTACK_SECRET_KEY="sk_test_replace-with-your-test-secret-key"
